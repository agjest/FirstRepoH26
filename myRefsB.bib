@article{knudsen1986,
  title = {Matrix {{Comparison}}, {{Goodness-of-Fit}}, and {{Spatial Interaction Modeling}}},
  author = {Knudsen, Daniel C. and Fotheringham, A. Stewart},
  date = {1986-08-01},
  journaltitle = {International Regional Science Review},
  volume = {10},
  number = {2},
  pages = {127--147},
  publisher = {SAGE Publications Inc},
  issn = {0160-0176},
  urldate = {2022-10-28},
  abstract = {The usefulness of various statistics for comparing observed and predicted spatial interaction matrices is examined. Results indicate that some statistics may yield misleading information about error levels in predicted matrices. Other statistics are found to be unsuitable for significance testing. The concept of experimental distributions is discussed for several of the statistics. Although framed in the context of spatial interaction modeling, the discussion is relevant to most matrix comparison problems.},
  langid = {english}
}

